{
  "name": "syntheseplaner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-rdkit.mjs && vite",
    "build": "node scripts/copy-rdkit.mjs && node scripts/generate-icons.mjs && vite-node scripts/build-catalog.ts && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.app.json",
    "icons": "node scripts/generate-icons.mjs",
    "tauri": "tauri",
    "tauri:dev": "npm run build && tauri dev",
    "tauri:build": "npm run build && tauri build",
    "catalog": "vite-node scripts/build-catalog.ts"
  },
  "dependencies": {
    "@rdkit/rdkit": "^2026.3.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.1",
    "wait-on": "^9.1.0"
  },
  "description": "Chemische Synthesen, Reaktionsgleichungen, Mechanismen und Elektrochemie – als App für Windows und iPad."
}
